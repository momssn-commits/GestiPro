# =============================================================================
# GestiPro — Variables d'environnement PRODUCTION
# Copier vers backend/.env sur le serveur et remplir toutes les valeurs
# =============================================================================

NODE_ENV=production
PORT=4000

# Base de données PostgreSQL (créée par setup-server.sh)
DATABASE_URL=postgresql://gestipro_user:CHANGER_MOT_DE_PASSE@localhost:5432/gestipro

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERER_UNE_CLE_SECRETE_LONGUE_ET_ALEATOIRE
JWT_EXPIRES_IN=7d

# Stockage fichiers
# Option A : Stockage local sur le serveur (simple, recommandé pour débuter)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=unused
S3_SECRET_KEY=unused
S3_BUCKET=gestipro-files
S3_REGION=us-east-1
# → Les fichiers seront sauvegardés dans backend/uploads/ automatiquement

# Option B : S3 réel (AWS, Cloudflare R2, etc.) — remplacer les valeurs ci-dessus
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET=gestipro-files-prod
# S3_REGION=eu-west-1

# URLs publiques
FRONTEND_URL=https://VOTRE_DOMAINE_OU_IP
APP_PUBLIC_URL=https://VOTRE_DOMAINE_OU_IP

# OnlyOffice (déjà configuré)
ONLYOFFICE_DOC_SERVER=https://api.onlyoffice.com/
ONLYOFFICE_JWT_SECRET=sk-68a1df10a191d08572b6fcbd440ef4ee869f1f13bb24a4230ac3939ade7beb7a
